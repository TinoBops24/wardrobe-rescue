@* One turn's individual pieces. The size picker modal and its script live once in
   Index.cshtml - this partial renders per chat turn, so it must stay markup only. *@
@model List<INF4027W_BPTTIN002_MiniPrj_2026.Pages.Assistant.ScoredProduct>

@if (Model.Any())
{
    <div class="row g-3 mt-2">
        @foreach (var scoredProduct in Model)
        {
            // Serialise sizes as a JSON array and encode single quotes inside it so
            // the value is safe inside a single-quoted HTML attribute.
            // This avoids Razor double-quote encoding (&quot;) which breaks JSON.parse.
            var sizesJson = System.Text.Json.JsonSerializer.Serialize(
            scoredProduct.Product.Sizes ?? new List<string>())
            .Replace("'", "\\'");

            <div class="col-12 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="d-flex p-3 gap-3 align-items-start">
                        <img src="@(string.IsNullOrEmpty(scoredProduct.Product.ImageUrl) ? "/porto/img/products/product-grey-1.jpg" : scoredProduct.Product.ImageUrl)"
                             alt="@scoredProduct.Product.Name"
                             class="rounded flex-shrink-0"
                             style="width:90px; height:110px; object-fit:cover; background:#f8f9fa;">

                        <div class="flex-grow-1 min-width-0">
                            <div class="d-flex align-items-start gap-2 mb-1">
                                <h6 class="mb-0 text-dark fw-bold flex-grow-1"
                                    style="font-size:0.9rem; line-height:1.3;">
                                    @scoredProduct.Product.Name
                                </h6>
                                <span class="badge bg-success rounded-pill flex-shrink-0"
                                      style="font-size:0.7rem; white-space:nowrap;">
                                    @scoredProduct.Score% Match
                                </span>
                            </div>
                            <div class="text-muted small mb-2">R @scoredProduct.Product.Price.ToString("N0")</div>
                            <ul class="mb-0 ps-3 text-muted" style="font-size:0.75rem;">
                                @foreach (var reason in scoredProduct.Reasons)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top-0 pt-0 pb-3 px-3">
                        <button type="button"
                                class="btn btn-outline-dark btn-sm w-100 rounded-pill wr-open-size-picker"
                                data-product-id="@scoredProduct.Product.Id"
                                data-product-name="@scoredProduct.Product.Name"
                                data-product-sizes='@Html.Raw(sizesJson)'>
                            Add to Cart
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

}
