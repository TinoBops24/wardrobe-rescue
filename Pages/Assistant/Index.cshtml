@page
@model INF4027W_BPTTIN002_MiniPrj_2026.Pages.Assistant.IndexModel
@using Microsoft.AspNetCore.Http
@using INF4027W_BPTTIN002_MiniPrj_2026.Helpers
@{
    ViewData["Title"] = "AI Stylist";
    Layout = "_ChatLayout";

    bool isProductSearch = Model.LastConstraints?.IsProductSearch == true;
    bool hasActiveSession = Model.CurrentSession != null && Model.CurrentSession.Messages.Any();
    var userId = HttpContext.Session.GetString(SessionKeys.UserId);
    var userName = HttpContext.Session.GetString(SessionKeys.UserName);
    bool isLoggedIn = userId != null;
    var displayName = !string.IsNullOrWhiteSpace(userName) ? userName : "Guest";
    var avatarInitial = displayName[0].ToString().ToUpperInvariant();
}

<div class="wr-app @(hasActiveSession ? "has-session" : "is-empty")" id="wr-app">
    <nav class="wr-rail" aria-label="Primary navigation">
        <a href="/Index" class="wr-rail-brand" aria-label="Wardrobe Rescue home">WR</a>
        <button type="button" class="wr-rail-link wr-rail-expand" id="wr-rail-expand" title="Expand workspace sidebar" aria-label="Expand workspace sidebar">
            <i class="fas fa-angles-right" aria-hidden="true"></i>
        </button>
        <a href="/Products" class="wr-rail-link" title="Shop" aria-label="Shop">
            <i class="fas fa-store" aria-hidden="true"></i>
        </a>
        <a href="/Assistant/Index" class="wr-rail-link active" title="AI Stylist" aria-label="AI Stylist" aria-current="page">
            <i class="far fa-comments" aria-hidden="true"></i>
        </a>
        <a href="/Account/Wishlist" class="wr-rail-link" title="Wishlist" aria-label="Wishlist">
            <i class="far fa-heart" aria-hidden="true"></i>
        </a>
        <a href="/Cart" class="wr-rail-link" title="Cart" aria-label="Cart">
            <i class="fas fa-bag-shopping" aria-hidden="true"></i>
        </a>
        <span class="wr-rail-spacer"></span>
        <a href="@(isLoggedIn ? "/Account/Profile" : "/Account/Login")"
           class="wr-rail-link wr-rail-avatar"
           title="@(isLoggedIn ? "Profile" : "Sign in")"
           aria-label="@(isLoggedIn ? "Profile" : "Sign in")">
            @avatarInitial
        </a>
    </nav>

    <aside class="wr-sidebar" id="wr-sidebar" aria-label="Styling workspace">
        <div class="wr-sidebar-head">
            <span class="wr-brand-mark" aria-hidden="true"><i class="fas fa-bolt"></i></span>
            <div class="wr-sidebar-brand">
                <strong>Wardrobe Rescue</strong>
                <span>AI styling workspace</span>
            </div>
            <button type="button" class="wr-sidebar-collapse" id="wr-sidebar-collapse" title="Collapse workspace sidebar" aria-label="Collapse workspace sidebar" aria-expanded="true">
                <i class="fas fa-angles-left" aria-hidden="true"></i>
            </button>
            <button type="button" class="wr-sidebar-close" data-sidebar-close aria-label="Close sidebar">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>

        <a href="/Assistant/Index" class="wr-new-chat">
            <i class="fas fa-plus" aria-hidden="true"></i>
            <span>New styling chat</span>
        </a>

        <div class="wr-sidebar-scroll">
            <div class="wr-sidebar-label">Style shortcuts</div>
            <button type="button" class="wr-style-shortcut" data-prompt="Build me a complete outfit for a job interview">
                <i class="fas fa-briefcase" aria-hidden="true"></i>
                <span>Interview ready</span>
            </button>
            <button type="button" class="wr-style-shortcut" data-prompt="Create a polished date night outfit for me">
                <i class="far fa-heart" aria-hidden="true"></i>
                <span>Date night edit</span>
            </button>
            <button type="button" class="wr-style-shortcut" data-prompt="Build me a versatile smart casual outfit">
                <i class="fas fa-shirt" aria-hidden="true"></i>
                <span>Smart casual</span>
            </button>
            <button type="button" class="wr-style-shortcut" data-prompt="Show me individual pieces that can refresh my wardrobe">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <span>Find a piece</span>
            </button>

            <div class="wr-sidebar-label">Recent style chats</div>
            @if (!isLoggedIn)
            {
                <div class="wr-signin-prompt">
                    <a href="/Account/Login">Sign in</a> to keep your styling history across devices.
                </div>
            }
            else if (Model.PastChats.Any())
            {
                foreach (var chat in Model.PastChats)
                {
                    <a href="/Assistant/Index?sessionId=@chat.Id"
                       class="wr-history-item @(Model.CurrentSessionId == chat.Id ? "active" : "")">
                        <i class="far fa-message" aria-hidden="true"></i>
                        <span>@chat.Title</span>
                    </a>
                }
            }
            else
            {
                <div class="wr-signin-prompt">Your saved styling conversations will appear here.</div>
            }
        </div>

        <div class="wr-sidebar-footer">
            <span class="wr-avatar" aria-hidden="true">@avatarInitial</span>
            <div class="wr-sidebar-user">
                <strong>@displayName</strong>
                <span>@(isLoggedIn ? "Wardrobe Rescue member" : "Guest session")</span>
            </div>
        </div>
    </aside>

    <button type="button" class="wr-sidebar-backdrop" data-sidebar-close aria-label="Close sidebar"></button>

    <section class="wr-chat-area" aria-label="Wardrobe Rescue AI Stylist">
        <header class="wr-chat-header">
            <div class="wr-chat-title">
                <button type="button" class="wr-mobile-menu" id="wr-mobile-menu" aria-controls="wr-sidebar" aria-expanded="false" aria-label="Open sidebar">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
                <div class="wr-assistant-pill">
                    <span class="wr-brand-mark" aria-hidden="true"><i class="fas fa-bolt"></i></span>
                    <strong>AI Stylist</strong>
                    <span>Wardrobe Rescue</span>
                </div>
            </div>
            <div class="wr-header-actions">
                <a href="/Products" class="wr-header-action" title="Browse the store" aria-label="Browse the store">
                    <i class="fas fa-store" aria-hidden="true"></i>
                </a>
                <a href="/Cart" class="wr-header-action" title="Open cart" aria-label="Open cart">
                    <i class="fas fa-bag-shopping" aria-hidden="true"></i>
                    <span class="wr-cart-count" id="nav-cart-count">@HttpContext.Session.GetCartCount()</span>
                </a>
            </div>
        </header>

        <div class="wr-messages" id="wr-chat-box" aria-live="polite">
            @if (!hasActiveSession)
            {
                <div class="wr-welcome">
                    <div class="wr-welcome-inner">
                        <span class="wr-brand-mark" aria-hidden="true"><i class="fas fa-bolt"></i></span>
                        <p class="wr-welcome-kicker">Your AI wardrobe stylist</p>
                        <h1>Wardrobe Rescue</h1>
                        <p>Tell us what you are dressing for. We will turn the pieces in our store into a considered look that fits your brief.</p>
                    </div>
                </div>
            }
            else
            {
                foreach (var message in Model.CurrentSession!.Messages)
                {
                    bool isLast = message == Model.CurrentSession.Messages.Last();

                    if (message.Role == "user")
                    {
                        <div class="wr-msg-row user">
                            <div>
                                <div class="wr-bubble-user">@message.Text</div>
                                <div class="wr-msg-time">You</div>
                            </div>
                        </div>
                    }
                    else if (message.Role == "ai")
                    {
                        <div class="wr-msg-row ai">
                            <span class="wr-ai-avatar" aria-hidden="true"><i class="fas fa-bolt"></i></span>
                            <div class="wr-bubble-ai-wrap">
                                <div class="wr-bubble-ai">
                                    @Html.Raw(System.Text.RegularExpressions.Regex.Replace(
                                        message.Text,
                                        @"\*\*(.*?)\*\*",
                                        "<strong>$1</strong>"))
                                </div>
                                <div class="wr-msg-time">Wardrobe Rescue AI Stylist</div>

                                @if (isLast && Model.HasResults)
                                {
                                    <div class="wr-results-area">
                                        @if (isProductSearch)
                                        {
                                            @await Html.PartialAsync("_ProductResults", Model)
                                            @if (Model.RecommendedBundles.Any())
                                            {
                                                @await Html.PartialAsync("_BundleResults", Model)
                                            }
                                        }
                                        else
                                        {
                                            @if (Model.RecommendedBundles.Any())
                                            {
                                                @await Html.PartialAsync("_BundleResults", Model)
                                            }
                                            @if (Model.RecommendedProducts.Any())
                                            {
                                                <h6 class="mt-4 mb-3 text-uppercase fw-bold" style="font-size:0.7rem; letter-spacing:1.2px; color:var(--wr-muted);">
                                                    Individual pieces
                                                </h6>
                                                @await Html.PartialAsync("_ProductResults", Model)
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
        </div>

        <div class="wr-input-area">
            <div class="wr-input-inner">
                <div id="wr-preview-strip" class="wr-preview-strip">
                    <img id="wr-preview-thumb" src="" alt="Uploaded clothing preview">
                    <span id="wr-preview-name"></span>
                    <button type="button" id="wr-preview-clear" title="Remove image" aria-label="Remove uploaded image">
                        <i class="fas fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <form method="post" enctype="multipart/form-data" asp-page="/Assistant/Index" id="wr-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CurrentSessionId" value="@Model.CurrentSessionId" />
                    <input type="file" id="wr-file-input" name="UploadedImage" accept="image/jpeg,image/png,image/webp" class="d-none">

                    <div class="wr-input-pill">
                        <label for="wr-file-input" class="wr-attach-btn" title="Upload a clothing photo" aria-label="Upload a clothing photo">
                            <i class="fas fa-paperclip" aria-hidden="true"></i>
                        </label>
                        <textarea id="wr-text-input"
                                  name="UserPrompt"
                                  class="wr-text-input"
                                  placeholder="Ask Wardrobe Rescue what to wear..."
                                  aria-label="Message Wardrobe Rescue AI Stylist"
                                  autocomplete="off"
                                  rows="1"></textarea>
                        <button type="submit" id="wr-send-btn" class="wr-send-btn" aria-label="Send message">
                            <i class="fas fa-arrow-up" aria-hidden="true"></i>
                        </button>
                    </div>
                </form>

                <div class="wr-input-footer">
                    <span>Check sizing and availability before checkout.</span>
                    <span class="wr-footer-separator" aria-hidden="true">•</span>
                    <a href="/Privacy">Privacy</a>
                    <span class="wr-footer-separator" aria-hidden="true">•</span>
                    <a href="/Products">Shop</a>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const app = document.getElementById('wr-app');
        const sidebarToggle = document.getElementById('wr-mobile-menu');
        const sidebarCollapse = document.getElementById('wr-sidebar-collapse');
        const sidebarExpand = document.getElementById('wr-rail-expand');
        const textarea = document.getElementById('wr-text-input');
        const form = document.getElementById('wr-form');
        const fileInput = document.getElementById('wr-file-input');
        const previewStrip = document.getElementById('wr-preview-strip');
        const previewThumb = document.getElementById('wr-preview-thumb');
        const previewName = document.getElementById('wr-preview-name');

        function setSidebar(open) {
            app.classList.toggle('sidebar-open', open);
            sidebarToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        function setSidebarCollapsed(collapsed) {
            app.classList.toggle('sidebar-collapsed', collapsed);
            sidebarCollapse.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
            sidebarCollapse.setAttribute('aria-label', collapsed ? 'Expand workspace sidebar' : 'Collapse workspace sidebar');
            sidebarCollapse.title = collapsed ? 'Expand workspace sidebar' : 'Collapse workspace sidebar';
        }

        function resizeComposer() {
            textarea.style.height = 'auto';
            textarea.style.height = Math.min(textarea.scrollHeight, 140) + 'px';
        }

        function fillPrompt(text) {
            textarea.value = text;
            resizeComposer();
            textarea.focus();
            setSidebar(false);
        }

        sidebarToggle.addEventListener('click', function () {
            setSidebar(!app.classList.contains('sidebar-open'));
        });

        sidebarCollapse.addEventListener('click', function () { setSidebarCollapsed(true); });
        sidebarExpand.addEventListener('click', function () { setSidebarCollapsed(false); });

        document.querySelectorAll('[data-sidebar-close]').forEach(function (button) {
            button.addEventListener('click', function () { setSidebar(false); });
        });

        document.querySelectorAll('[data-prompt]').forEach(function (button) {
            button.addEventListener('click', function () { fillPrompt(this.dataset.prompt); });
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') setSidebar(false);
        });

        textarea.addEventListener('input', resizeComposer);
        textarea.addEventListener('keydown', function (event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                form.requestSubmit();
            }
        });

        form.addEventListener('submit', function (event) {
            const hasText = textarea.value.trim().length > 0;
            const hasImage = fileInput.files.length > 0;

            if (!hasText && !hasImage) {
                event.preventDefault();
                textarea.focus();
                return;
            }

            const sendButton = document.getElementById('wr-send-btn');
            const chatBox = document.getElementById('wr-chat-box');
            const typingRow = document.createElement('div');
            typingRow.className = 'wr-msg-row ai';
            typingRow.id = 'wr-typing-indicator';
            typingRow.innerHTML = '<span class="wr-ai-avatar" aria-hidden="true"><i class="fas fa-bolt"></i></span><div class="wr-typing"><span></span><span></span><span></span></div>';
            chatBox.appendChild(typingRow);
            chatBox.scrollTop = chatBox.scrollHeight;
            sendButton.disabled = true;
            sendButton.innerHTML = '<i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i>';
        });

        fileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (event) {
                previewThumb.src = event.target.result;
                previewName.textContent = file.name;
                previewStrip.classList.add('visible');
            };
            reader.readAsDataURL(file);
        });

        document.getElementById('wr-preview-clear').addEventListener('click', function () {
            fileInput.value = '';
            previewThumb.src = '';
            previewStrip.classList.remove('visible');
        });

        document.addEventListener('DOMContentLoaded', function () {
            const chatBox = document.getElementById('wr-chat-box');
            chatBox.scrollTop = chatBox.scrollHeight;
        });
    </script>
}
