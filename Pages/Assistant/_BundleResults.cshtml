@* One turn's outfits. The bundle size modal and its script live once in
   Index.cshtml - this partial renders per chat turn, so it must stay markup only. *@
@model List<INF4027W_BPTTIN002_MiniPrj_2026.Models.Bundle>

@if (Model.Any())
{
    <h6 class="mt-4 mb-3 text-uppercase fw-bold text-muted" style="font-size: 0.8rem; letter-spacing: 1px;">
        Suggested Outfits
    </h6>
    <div class="row g-3">
        @foreach (var bundle in Model)
        {
            // Build a JSON array of {id, name, sizes} for each product in the bundle
            var bundleItemsJson = System.Text.Json.JsonSerializer.Serialize(
            bundle.ResolvedProducts.Select(p => new
            {
                id = p.Id,
                name = p.Name,
                sizes = p.Sizes ?? new List<string>()
            })
            ).Replace("'", "\\'");

            <div class="col-md-6">
                <div class="card border border-dark rounded-3 overflow-hidden">
                    <div class="row g-0">
                        <!-- Image grid -->
                        <div class="col-5">
                            <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:4px; background:#fff; padding:8px; border-radius:8px; aspect-ratio:1;">
                                @foreach (var p in bundle.ResolvedProducts.Take(4))
                                {
                                    <div style="overflow:hidden; display:flex; align-items:center; justify-content:center; background:#f9f9f9;">
                                        <img src="@p.ImageUrl" alt="@p.Name"
                                             style="width:100%; height:100%; object-fit:contain; padding:4px;" />
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Bundle metadata -->
                        <div class="col-7">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="card-title mb-0 fw-bold text-dark">@bundle.Name</h6>
                                    @if (bundle.ExplainableScores.ContainsKey("Total Match Score"))
                                    {
                                        <span class="badge bg-dark rounded-pill ms-2">
                                            @bundle.ExplainableScores["Total Match Score"]% Match
                                        </span>
                                    }
                                </div>

                                <span class="badge bg-secondary mb-2">@bundle.Occasion</span>
                                <p class="card-text fw-bold mb-2">R @bundle.TotalPrice.ToString("N0")</p>

                                @if (bundle.RiskFlags.Any())
                                {
                                    <div class="p-2 bg-light rounded text-muted mb-2" style="font-size: 0.75rem;">
                                        <strong>Why this outfit:</strong>
                                        <ul class="mb-0 ps-3 mt-1">
                                            @foreach (var flag in bundle.RiskFlags)
                                            {
                                                <li>@flag</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                <div class="mb-2" style="font-size: 0.75rem; color: #666;">
                                    @foreach (var p in bundle.ResolvedProducts)
                                    {
                                        <span class="d-block">• @p.Name</span>
                                    }
                                </div>

                                <button type="button"
                                        class="btn btn-dark btn-sm w-100 wr-add-bundle-btn"
                                        data-bundle-items='@Html.Raw(bundleItemsJson)'>
                                    <i class="fas fa-shopping-bag me-1"></i> Add Outfit to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

}
