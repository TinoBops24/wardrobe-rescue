@page
@model INF4027W_BPTTIN002_MiniPrj_2026.Pages.ErrorModel
@{
    ViewData["Title"] = Model.Title;
}

<div role="main" class="main">
    <section class="page-header page-header-modern page-header-md bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-12 align-self-center p-static order-first order-md-last">
                    <h1 class="font-weight-bold text-dark">@Model.StatusCode</h1>
                </div>
            </div>
        </div>
    </section>

    <div class="container py-5 my-5">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">

                <p class="text-color-primary font-weight-semibold text-2 mb-2">
                    ERROR @Model.StatusCode
                </p>
                <h2 class="font-weight-bold text-color-dark text-8 mb-3">
                    @Model.Title
                </h2>
                <p class="text-muted mb-5">
                    @Model.Message
                </p>

                <a asp-page="/Index" class="btn btn-primary btn-px-5 btn-py-3 me-2">
                    <i class="fas fa-home me-2"></i>Go Home
                </a>
                <a asp-page="/Products/Index" class="btn btn-outline-primary btn-px-5 btn-py-3">
                    Browse Products
                </a>

            </div>
        </div>
    </div>
</div>
