@using INF4027W_BPTTIN002_MiniPrj_2026.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wardrobe Rescue</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --porto-blue: #0088cc;
            --porto-blue-dark: #006699;
            --porto-blue-deeper: #004d73;
            --sidebar-width: 280px;
            --navbar-height: 60px;
            --bg-main: #f8f9fb;
            --bg-white: #ffffff;
            --text-primary: #212529;
            --text-muted: #9ca3af;
            --text-sidebar: rgba(255,255,255,0.9);
            --text-sidebar-dim: rgba(255,255,255,0.55);
            --border-light: #e5e7eb;
            --shadow-soft: 0 2px 12px rgba(0,0,0,0.07);
            --shadow-input: 0 4px 20px rgba(0,136,204,0.12);
            --radius-bubble: 1.25rem;
            --font-body: Poppins, 'Open Sans', sans-serif;
            --font-display: 'Playfair Display', Georgia, serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--bg-main);
            overflow: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        .wr-navbar {
            height: var(--navbar-height);
            background: var(--bg-white);
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            flex-shrink: 0;
            z-index: 1050;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }

        .wr-navbar-brand {
            font-family: var(--font-display);
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-primary);
            letter-spacing: 0.3px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .wr-navbar-brand .ai-badge {
                font-family: var(--font-body);
                font-size: 0.65rem;
                font-weight: 600;
                background: var(--porto-blue);
                color: white;
                padding: 2px 8px;
                border-radius: 20px;
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }

        .wr-navbar a {
            text-decoration: none;
            color: #6b7280;
            font-size: 0.875rem;
            font-weight: 500;
            transition: color 0.2s;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

            .wr-navbar a:hover {
                color: var(--porto-blue);
            }

        .wr-cart-btn {
            position: relative;
        }

            .wr-cart-btn .cart-count {
                position: absolute;
                top: -6px;
                right: -8px;
                background: #ef4444;
                color: white;
                font-size: 0.6rem;
                font-weight: 700;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                line-height: 1;
            }

        .wr-main {
            flex-grow: 1;
            overflow: hidden;
            display: flex;
        }

        .wr-toast-container {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
        }

        .wr-toast {
            background: #111827;
            color: #ffffff;
            border-radius: 0.75rem;
            padding: 0.875rem 1.25rem;
            font-size: 0.875rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.625rem;
            box-shadow: 0 8px 24px rgba(0,0,0,0.18);
            min-width: 260px;
            animation: toastIn 0.3s cubic-bezier(0.34,1.56,0.64,1);
        }

            .wr-toast i {
                color: #4ade80;
                font-size: 1rem;
            }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.95);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes toastOut {
            from {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            to {
                opacity: 0;
                transform: translateY(8px) scale(0.95);
            }
        }

        .wr-toast.hiding {
            animation: toastOut 0.25s ease forwards;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="wr-navbar shadow-sm">
        <a href="/Products">
            <i class="fas fa-arrow-left" style="font-size:0.8rem;"></i>
            <span>Store</span>
        </a>

        <div class="wr-navbar-brand">
            <a href="/Index" class="d-flex align-items-center text-decoration-none">
                <img src="https://raw.githubusercontent.com/TinoBops24/wardrobe-rescue-images/main/WR-logo.png"
                     alt="Wardrobe Rescue"
                     style="height:36px;width:auto;">
            </a>
            <span class="ai-badge ms-2">AI</span>
        </div>

        <a href="/Cart" class="wr-cart-btn">
            <i class="fas fa-shopping-bag" style="font-size: 1rem;"></i>
            <!-- Initialised server-side so it's correct on every page load -->
            <span class="cart-count" id="nav-cart-count">
                @Context.Session.GetCartCount()
            </span>
        </a>
    </nav>

    <div class="wr-main">
        @RenderBody()
    </div>

    <div class="wr-toast-container" id="wr-toast-container"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function showToast(message, icon) {
            icon = icon || 'fa-circle-check';
            var container = document.getElementById('wr-toast-container');
            var toast = document.createElement('div');
            toast.className = 'wr-toast';
            toast.innerHTML = '<i class="fas ' + icon + '"></i><span>' + message + '</span>';
            container.appendChild(toast);

            setTimeout(function () {
                toast.classList.add('hiding');
                setTimeout(function () { toast.remove(); }, 280);
            }, 3000);
        }

        @if (TempData["AssistantSuccess"] != null)
        {
                <text>
                document.addEventListener('DOMContentLoaded', function () {
                    showToast('@Html.Raw(TempData["AssistantSuccess"]?.ToString()?.Replace("'", "\\'"))');
                });
                </text>
        }

        document.addEventListener('DOMContentLoaded', function () {
            var tooltipEls = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            tooltipEls.forEach(function (el) { new bootstrap.Tooltip(el); });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
