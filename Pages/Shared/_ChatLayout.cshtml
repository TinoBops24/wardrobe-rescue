@using INF4027W_BPTTIN002_MiniPrj_2026.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wardrobe Rescue</title>
    <link rel="icon" href="~/logo/wardrobe-rescue-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="~/logo/wardrobe-rescue-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/assistant.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <main class="wr-main">
        @RenderBody()
    </main>

    <div class="wr-toast-container" id="wr-toast-container" aria-live="polite"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function showToast(message, icon) {
            const container = document.getElementById('wr-toast-container');
            const toast = document.createElement('div');
            const toastIcon = document.createElement('i');
            const toastMessage = document.createElement('span');

            toast.className = 'wr-toast';
            toastIcon.className = 'fas ' + (icon || 'fa-circle-check');
            toastMessage.textContent = message;
            toast.append(toastIcon, toastMessage);
            container.appendChild(toast);

            setTimeout(function () {
                toast.classList.add('hiding');
                setTimeout(function () { toast.remove(); }, 220);
            }, 3000);
        }

        @if (TempData["AssistantSuccess"] != null)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["AssistantSuccess"]?.ToString())));
            });
            </text>
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (element) {
                new bootstrap.Tooltip(element);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
