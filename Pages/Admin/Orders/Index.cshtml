@page
@model INF4027W_BPTTIN002_MiniPrj_2026.Pages.Admin.Orders.IndexModel
@using INF4027W_BPTTIN002_MiniPrj_2026.Models
@{
    ViewData["Title"] = "Orders";
    Layout = "_AdminLayout";
}

<div id="orderStats" class="accordion-collapse collapse page-header-collapse">
    <div class="accordion-body pb-2">
        <div class="row">
            <div class="col-xxl-3 col-md-6">
                <div class="card stretch stretch-full">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <a href="javascript:void(0);" class="fw-bold d-block">
                                <span class="d-block text-muted fs-12">Total Orders</span>
                                <span class="fs-20 fw-bold d-block text-dark">@Model.TotalCount</span>
                            </a>
                            <div class="avatar-text bg-soft-primary text-primary rounded">
                                <i class="feather-shopping-bag"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-3 col-md-6">
                <div class="card stretch stretch-full">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <a href="javascript:void(0);" class="fw-bold d-block">
                                <span class="d-block text-muted fs-12">Paid Orders</span>
                                <span class="fs-20 fw-bold d-block text-dark">@Model.PaidCount</span>
                            </a>
                            <div class="avatar-text bg-soft-success text-success rounded">
                                <i class="feather-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-3 col-md-6">
                <div class="card stretch stretch-full">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <a href="javascript:void(0);" class="fw-bold d-block">
                                <span class="d-block text-muted fs-12">Total Revenue</span>
                                <span class="fs-20 fw-bold d-block text-dark">R @Model.TotalRevenue.ToString("N0")</span>
                            </a>
                            <div class="avatar-text bg-soft-warning text-warning rounded">
                                <i class="feather-dollar-sign"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-3 col-md-6">
                <div class="card stretch stretch-full">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <a href="javascript:void(0);" class="fw-bold d-block">
                                <span class="d-block text-muted fs-12">Total Profit</span>
                                <span class="fs-20 fw-bold d-block text-dark">R @Model.TotalProfit.ToString("N0")</span>
                            </a>
                            <div class="avatar-text bg-soft-teal text-teal rounded">
                                <i class="feather-trending-up"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card stretch stretch-full">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0">All Orders</h5>
                <a href="javascript:void(0);" class="btn btn-icon btn-light-brand"
                   data-bs-toggle="collapse" data-bs-target="#orderStats"
                   title="Toggle Stats">
                    <i class="feather-bar-chart"></i>
                </a>
            </div>
            <div class="card-body p-0">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success mx-4 mt-3" role="alert">
                        <i class="feather-check-circle me-2"></i>@TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mx-4 mt-3" role="alert">
                        <i class="feather-alert-circle me-2"></i>@TempData["Error"]
                    </div>
                }

                @if (!Model.Orders.Any() && Model.TotalCount == 0)
                {
                    <div class="text-center py-5">
                        <i class="feather-shopping-bag fs-1 text-muted mb-3 d-block"></i>
                        <h5 class="text-muted">No orders yet</h5>
                        <p class="text-muted fs-13">Orders placed by customers will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="px-4 pt-4">
                        <ul class="nav nav-tabs gap-1 mb-0">
                            <li class="nav-item">
                                <a class="nav-link @(Model.Filter == "all" ? "active" : "")"
                                   asp-page="/Admin/Orders/Index" asp-route-filter="all">
                                    All <span class="badge bg-gray-200 text-dark ms-1">@Model.TotalCount</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Model.Filter == "paid" ? "active" : "")"
                                   asp-page="/Admin/Orders/Index" asp-route-filter="paid">
                                    Paid <span class="badge bg-soft-success text-success ms-1">@Model.PaidCount</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Model.Filter == "cancelled" ? "active" : "")"
                                   asp-page="/Admin/Orders/Index" asp-route-filter="cancelled">
                                    Cancelled <span class="badge bg-soft-danger text-danger ms-1">@Model.CancelledCount</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    @if (!Model.Orders.Any())
                    {
                        <div class="text-center py-5">
                            <p class="text-muted fs-13">No orders match this filter.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-gray-200">
                                    <tr>
                                        <th class="ps-4">Order ID</th>
                                        <th>Customer</th>
                                        <th>Items</th>
                                        <th>Amount</th>
                                        <th>Payment</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders)
                                    {
                                        var initial = string.IsNullOrEmpty(order.CustomerName) ? "?" : order.CustomerName[0].ToString().ToUpper();
                                        var avatarColours = new[] { "bg-primary", "bg-success", "bg-warning", "bg-teal", "bg-indigo", "bg-danger" };
                                        var colourIndex = Math.Abs(order.CustomerName.GetHashCode()) % avatarColours.Length;
                                        var avatarClass = avatarColours[colourIndex];

                                        <tr>
                                            <td class="ps-4">
                                                <span class="fw-bold text-primary fs-13">@order.Id.ToUpper()</span>
                                            </td>
                                            <td>
                                                <div class="hstack gap-3">
                                                    <div class="avatar-text avatar-md @avatarClass text-white">@initial</div>
                                                    <div>
                                                        <span class="d-block fw-semibold">@order.CustomerName</span>
                                                        <small class="fs-12 text-muted">@order.CustomerEmail</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-gray-200 text-dark">@order.Items.Count item@(order.Items.Count != 1 ? "s" : "")</span>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-dark">R @order.TotalAmount.ToString("N0")</span>
                                            </td>
                                            <td>
                                                @{
                                                    var pmIcon = order.PaymentMethod switch
                                                    {
                                                        PaymentMethod.Card => "feather-credit-card",
                                                        PaymentMethod.EFT => "feather-refresh-cw",
                                                        PaymentMethod.PayPal => "feather-dollar-sign",
                                                        _ => "feather-circle"
                                                    };
                                                }
                                                <span class="hstack gap-1 text-muted fs-13">
                                                    <i class="@pmIcon fs-12"></i>
                                                    @order.PaymentMethod
                                                </span>
                                            </td>
                                            <td class="text-muted fs-13">
                                                @order.OrderDate.ToDateTime().ToString("dd MMM yyyy")
                                                <small class="d-block text-muted fs-11">@order.OrderDate.ToDateTime().ToString("HH:mm")</small>
                                            </td>
                                            <td>
                                                @if (order.Status == OrderStatus.Paid)
                                                {
                                                    <span class="badge bg-soft-success text-success">Paid</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-soft-danger text-danger">Cancelled</span>
                                                }
                                            </td>
                                            <td>
                                                <form method="post" asp-page-handler="UpdateStatus">
                                                    <input type="hidden" name="orderId" value="@order.Id" />
                                                    <input type="hidden" name="filter" value="@Model.Filter" />
                                                    @if (order.Status == OrderStatus.Paid)
                                                    {
                                                        <button type="submit" name="newStatus" value="Cancelled"
                                                                class="btn btn-sm btn-soft-danger"
                                                                onclick="return confirm('Cancel order @order.Id?')">
                                                            <i class="feather-x me-1"></i>Cancel
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" name="newStatus" value="Paid"
                                                                class="btn btn-sm btn-soft-success"
                                                                onclick="return confirm('Mark order @order.Id as Paid?')">
                                                            <i class="feather-check me-1"></i>Mark Paid
                                                        </button>
                                                    }
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }

            </div>
        </div>
    </div>
</div>