@page
@model INF4027W_BPTTIN002_MiniPrj_2026.Pages.Admin.Reports.FinancialModel
@using INF4027W_BPTTIN002_MiniPrj_2026.Models
@{
    ViewData["Title"] = "Financial Report";
    Layout = "_AdminLayout";
}

@section Styles {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
}

<div class="row">
    <div class="col-xxl-3 col-md-6">
        <div class="card stretch stretch-full border-start border-primary border-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-4">
                    <div class="avatar-text avatar-lg bg-soft-primary text-primary">
                        <i class="feather-trending-up"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">R @Model.TotalRevenue.ToString("N0")</div>
                        <h3 class="fs-13 fw-semibold text-muted mb-0">Total Revenue</h3>
                        <small class="text-muted fs-11">Sum of all paid orders</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-3 col-md-6">
        <div class="card stretch stretch-full border-start border-warning border-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-4">
                    <div class="avatar-text avatar-lg bg-soft-warning text-warning">
                        <i class="feather-shopping-cart"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">R @Model.TotalCost.ToString("N0")</div>
                        <h3 class="fs-13 fw-semibold text-muted mb-0">Cost of Sales</h3>
                        <small class="text-muted fs-11">Sum of costs for paid orders</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-3 col-md-6">
        <div class="card stretch stretch-full border-start @(Model.NetProfit >= 0 ? "border-success" : "border-danger") border-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-4">
                    <div class="avatar-text avatar-lg @(Model.NetProfit >= 0 ? "bg-soft-success text-success" : "bg-soft-danger text-danger")">
                        <i class="feather-dollar-sign"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold @(Model.NetProfit >= 0 ? "text-success" : "text-danger")">R @Model.NetProfit.ToString("N0")</div>
                        <h3 class="fs-13 fw-semibold text-muted mb-0">Net Profit</h3>
                        <small class="text-muted fs-11">Revenue minus cost of sales</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-3 col-md-6">
        <div class="card stretch stretch-full border-start border-teal border-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-4">
                    <div class="avatar-text avatar-lg bg-soft-teal text-teal">
                        <i class="feather-percent"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@Model.ProfitMargin.ToString("N1")%</div>
                        <h3 class="fs-13 fw-semibold text-muted mb-0">Profit Margin</h3>
                        <small class="text-muted fs-11">Net profit as % of revenue</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-2">
    <div class="col-xxl-5 col-md-12">
        <div class="card stretch stretch-full">
            <div class="card-header">
                <h5 class="card-title">Revenue vs Cost vs Profit</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="financialChart" style="max-height:280px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xxl-7 col-md-12">
        <div class="card stretch stretch-full">
            <div class="card-header">
                <h5 class="card-title">Order Breakdown</h5>
                <small class="text-muted fs-11">Paid orders only</small>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-gray-200">
                            <tr>
                                <th class="ps-4">Order ID</th>
                                <th>Customer</th>
                                <th>Revenue</th>
                                <th>Cost</th>
                                <th>Profit</th>
                                <th>Margin</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PaidOrders.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted fs-13">No paid orders yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var order in Model.PaidOrders)
                                {
                                    var profit = order.TotalAmount - order.TotalCost;
                                    var margin = order.TotalAmount > 0 ? (profit / order.TotalAmount) * 100 : 0;
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-semibold text-primary fs-13">@order.Id</span>
                                        </td>
                                        <td class="fs-13">@order.CustomerName</td>
                                        <td class="fw-semibold fs-13">R @order.TotalAmount.ToString("N0")</td>
                                        <td class="text-muted fs-13">R @order.TotalCost.ToString("N0")</td>
                                        <td>
                                            <span class="fw-semibold @(profit >= 0 ? "text-success" : "text-danger") fs-13">
                                                R @profit.ToString("N0")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @(margin >= 30 ? "bg-soft-success text-success" : margin >= 10 ? "bg-soft-warning text-warning" : "bg-soft-danger text-danger")">
                                                @margin.ToString("N1")%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('financialChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Revenue', 'Cost of Sales', 'Net Profit'],
                datasets: [{
                    data: [@Model.TotalRevenue.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @Model.TotalCost.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @Model.NetProfit.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)],
                    backgroundColor: ['rgba(93,135,255,0.2)', 'rgba(255,193,7,0.2)', 'rgba(23,198,120,0.2)'],
                    borderColor: ['#5d87ff', '#ffc107', '#17c678'],
                    borderWidth: 2,
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return 'R ' + value.toLocaleString();
                            }
                        }
                    }
                }
            }
        });
    </script>
}
