@page
@model INF4027W_BPTTIN002_MiniPrj_2026.Pages.Admin.Reports.CustomersModel
@{
    ViewData["Title"] = "Customer Report";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-xxl-3 col-md-6">
        <div class="card stretch stretch-full">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between mb-4">
                    <div class="d-flex gap-4 align-items-center">
                        <div class="avatar-text avatar-lg bg-gray-200">
                            <i class="feather-users"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-dark">@Model.TotalCustomers</div>
                            <h3 class="fs-13 fw-semibold text-truncate-1-line">Total Customers</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-3 col-md-6">
        <div class="card stretch stretch-full">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between mb-4">
                    <div class="d-flex gap-4 align-items-center">
                        <div class="avatar-text avatar-lg bg-gray-200">
                            <i class="feather-user-check"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-dark">@Model.ActiveCustomers</div>
                            <h3 class="fs-13 fw-semibold text-truncate-1-line">Active Customers</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-3 col-md-6">
        <div class="card stretch stretch-full">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between mb-4">
                    <div class="d-flex gap-4 align-items-center">
                        <div class="avatar-text avatar-lg bg-gray-200">
                            <i class="feather-shopping-bag"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-dark">R @Model.AverageOrderValue.ToString("N0")</div>
                            <h3 class="fs-13 fw-semibold text-truncate-1-line">Avg Order Value</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-3 col-md-6">
        <div class="card stretch stretch-full">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between mb-4">
                    <div class="d-flex gap-4 align-items-center">
                        <div class="avatar-text avatar-lg bg-gray-200">
                            <i class="feather-award"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-dark text-truncate" style="max-width:140px;">@Model.TopCustomerName</div>
                            <h3 class="fs-13 fw-semibold text-truncate-1-line">Top Customer</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-2">
    <div class="col-12">
        <div class="card stretch stretch-full">
            <div class="card-header">
                <h5 class="card-title">Customer Overview</h5>
                <small class="text-muted fs-11">Sorted by total spend</small>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-gray-200">
                            <tr>
                                <th class="ps-4" style="width:40px;">#</th>
                                <th>Customer</th>
                                <th>Orders</th>
                                <th>Total Spent</th>
                                <th>Avg Order</th>
                                <th>Last Order</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.CustomerStats.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted fs-13">No customer data available.</td>
                                </tr>
                            }
                            else
                            {
                                var avatarColours = new[] { "bg-primary", "bg-success", "bg-warning", "bg-teal", "bg-indigo", "bg-danger" };
                                var customerRank = 1;
                                @foreach (var c in Model.CustomerStats)
                                {
                                    var initial = string.IsNullOrEmpty(c.FullName) ? "?" : c.FullName[0].ToString().ToUpper();
                                    var colourIndex = Math.Abs(c.FullName.GetHashCode()) % avatarColours.Length;
                                    var avatarClass = avatarColours[colourIndex];
                                    var isTopCustomer = customerRank == 1;
                                    <tr class="@(isTopCustomer ? "table-success" : "")">
                                        <td class="ps-4">
                                            <span class="fw-bold @(isTopCustomer ? "text-success" : "text-muted") fs-13">@customerRank</span>
                                        </td>
                                        <td>
                                            <div class="hstack gap-3">
                                                <div class="avatar-text avatar-md @(isTopCustomer ? "bg-success" : avatarClass) text-white">@initial</div>
                                                <div>
                                                    <span class="d-block fw-semibold fs-13 @(isTopCustomer ? "text-success" : "")">@c.FullName</span>
                                                    <small class="fs-12 @(isTopCustomer ? "text-success" : "text-muted")">@c.Email</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-gray-200 text-dark">@c.TotalOrders order@(c.TotalOrders != 1 ? "s" : "")</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold @(isTopCustomer ? "text-success" : "text-dark")">R @c.TotalSpent.ToString("N0")</span>
                                        </td>
                                        <td class="@(isTopCustomer ? "text-success" : "text-muted") fs-13">R @c.AverageOrderValue.ToString("N0")</td>
                                        <td class="text-muted fs-13">
                                            @(c.LastOrderDate.HasValue? c.LastOrderDate.Value.ToString("dd MMM yyyy") : "—")
                                        </td>
                                        <td>
                                            @if (c.IsActive)
                                            {
                                                <span class="badge bg-soft-success text-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-soft-danger text-danger">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                    customerRank++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
