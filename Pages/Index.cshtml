    <div class="container py-4 py-lg-5">
        <div class="row text-center text-lg-start py-lg-5">
            <div class="col pb-4 pt-4 mt-5">
                <div class="overflow-hidden mb-4">
                    <div class="appear-animation" data-appear-animation="maskUp">
                        <span class="text-light d-inline-block text-3-5 rounded-pill px-4 py-1 font-weight-medium border border-secondary">
                            Why Wardrobe Rescue
                        </span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-4 mb-5 mb-lg-0">
                        <div class="text-lg-start">
                            <div class="appear-animation" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="0">
                                <strong class="custom-highlight-text-1" data-to="95" data-append="%" data-plugin-counter data-plugin-options="{'speed': 2000}">0</strong>
                            </div>
                        </div>
                        <h3 class="text-light mb-3 text-8 ls-0 line-height-1">Outfit Match Rate</h3>
                        <p class="text-3-5 text-grey mb-4 pe-4">Our AI scoring engine matches outfit components across formality, colour, and occasion with industry-leading precision.</p>
                    </div>
                    <div class="col-lg-4 mb-5 mb-lg-0">
                        <div class="text-lg-start">
                            <div class="appear-animation" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="200">
                                <strong class="custom-highlight-text-1" data-to="3" data-append="x" data-plugin-counter data-plugin-options="{'speed': 2000}">0</strong>
                            </div>
                        </div>
                        <h3 class="text-light mb-3 text-8 ls-0 line-height-1">Faster Outfit Selection</h3>
                        <p class="text-3-5 text-grey mb-4 pe-4">Shoppers using AI bundle recommendations find their complete look three times faster than browsing individually.</p>
                    </div>
                    <div class="col-lg-4">
                        <div class="text-lg-start">
                            <div class="appear-animation" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="400">
                                <strong class="custom-highlight-text-1" data-to="100" data-append="+" data-plugin-counter data-plugin-options="{'speed': 2000}">0</strong>
                            </div>
                        </div>
                        <h3 class="text-light mb-3 text-8 ls-0 line-height-1">Curated Items</h3>
                        <p class="text-3-5 text-grey mb-4 pe-4">Every product assessed for formality, colour profile, and occasion suitability before being listed in the catalogue.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── FEATURED PRODUCTS ── -->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <div class="custom-bg-color-1">
        <div class="container py-5">
            <div class="row text-center mb-5 pt-4">
                <div class="col">
                    <div class="overflow-hidden">
                        <div class="appear-animation" data-appear-animation="maskUp">
                            <span class="bg-dark text-light d-inline-block text-3-5 rounded-pill px-4 py-1 font-weight-medium">New Arrivals</span>
                        </div>
                    </div>
                    <h2 class="custom-font-1 mt-3 mb-1 ls-0">Featured <strong>Products</strong></h2>
                    <p class="text-color-grey text-4">Individually selected for style and versatility</p>
                </div>
            </div>
            <div class="row products pb-5">
                @foreach (var product in Model.FeaturedProducts.Take(4))
                {
                    var idx = Model.FeaturedProducts.Take(4).ToList().IndexOf(product);
                    <div class="col-sm-6 col-lg-3 mb-4">
                        <div class="product mb-0 appear-animation" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="@(idx * 150)">
                            <div class="product-thumb-info border-0 mb-3">
                                @if (product.IsNew)
                                {
                                    <div class="product-thumb-info-badges-wrapper">
                                        <span class="badge badge-ecommerce text-bg-success">NEW</span>
                                    </div>
                                }
                                @if (product.DiscountPercentage > 0)
                                {
                                    <div class="product-thumb-info-badges-wrapper">
                                        <span class="badge badge-ecommerce text-bg-danger">@(product.DiscountPercentage)% OFF</span>
                                    </div>
                                }
                                <div class="addtocart-btn-wrapper">
                                    <a asp-page="/Products/Details" asp-route-id="@product.Id" class="text-decoration-none addtocart-btn" title="View Product">
                                        <i class="icons icon-bag"></i>
                                    </a>
                                </div>
                                <a asp-page="/Products/Details" asp-route-id="@product.Id">
                                    <div class="product-thumb-info-image bg-white border custom-border-radius-1">
                                        <img alt="@product.Name" class="img-fluid" src="@product.ImageUrl"
                                             style="height:280px;object-fit:contain;width:100%;padding:12px;">
                                    </div>
                                </a>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>
                                    <a asp-page="/Products/Index" asp-route-SelectedCategory="@product.Category"
                                       class="d-block text-uppercase text-decoration-none text-color-default text-color-hover-primary line-height-1 text-0 mb-1">
                                        @product.Category
                                    </a>
                                    <h3 class="text-3-5 font-weight-medium font-alternative text-transform-none line-height-3 mb-0">
                                        <a asp-page="/Products/Details" asp-route-id="@product.Id" class="text-color-dark text-color-hover-primary">@product.Name</a>
                                    </h3>
                                </div>
                                <a href="#" class="text-decoration-none text-color-default text-color-hover-dark text-4">
                                    <i class="far fa-heart"></i>
                                </a>
                            </div>
                            <div title="Rated @product.Rating out of 5">
                                <input type="text" class="d-none" value="@product.Rating"
                                       data-plugin-star-rating data-plugin-options="{'displayOnly': true, 'color': 'default', 'size':'xs'}">
                            </div>
                            <p class="price text-5 mb-3">
                                @if (product.DiscountPrice.HasValue)
                                {
                                    <span class="sale text-color-dark font-weight-semi-bold">R @(product.DiscountPrice.Value.ToString("N0"))</span>
                                    <span class="amount text-decoration-line-through text-muted ms-1">R @(product.Price.ToString("N0"))</span>
                                }
                                else
                                {
                                    <span class="sale text-color-dark font-weight-semi-bold">R @(product.Price.ToString("N0"))</span>
                                }
                            </p>
                        </div>
                    </div>
                }
            </div>
            <div class="row pb-5">
                <div class="col text-center">
                    <a asp-page="/Products/Index" class="btn btn-modern btn-effect-4 btn-rounded btn-dark text-transform-none text-3 font-weight-medium">
                        View All Products <i class="fas fa-arrow-right rotate-l-45 ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

