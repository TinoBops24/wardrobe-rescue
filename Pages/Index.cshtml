    <div class="gsap-section-scale custom-section-1">
        <div class="custom-section-1-box bg-dark custom-border-radius-1 w-100 h-100 p-relative">
            <div class="container py-5 z-index-1 p-relative">
                <div class="row justify-content-center text-center text-xl-start align-items-center py-4">
                    <div class="col-xl-8">
                        <div class="overflow-hidden">
                            <div class="appear-animation" data-appear-animation="maskUp">
                                <h3 class="custom-font-1 text-light mb-0">
                                    Empowering <span class="text-color-primary">your wardrobe</span> with AI that understands
                                    <span class="custom-word-highlight-1 d-inline-block p-relative text-color-primary">
                                        <span class="p-relative z-index-2">style.</span>
                                    </span>
                                </h3>
                            </div>
                        </div>
                        <div class="appear-animation mt-4" data-appear-animation="fadeInUpShorter" data-appear-animation-delay="500">
                            <a asp-page="/Assistant/Index"
                               class="btn btn-modern btn-effect-4 btn-rounded btn-primary text-transform-none text-3 font-weight-medium mt-2 mb-2">
                                Try AI Stylist <i class="fas fa-arrow-right rotate-l-45 ms-2"></i>
                            </a>
                        </div>
                    </div>
                    <div class="col-xl-4 pt-5 pt-xl-0 text-center">
                        <div class="appear-animation" data-appear-animation="fadeIn" data-appear-animation-delay="800">
                            <p class="text-4 text-grey mb-0">
                                Unlock your personal style with AI-curated bundles that connect occasion, fit, and colour into one confident look.
                            </p>
