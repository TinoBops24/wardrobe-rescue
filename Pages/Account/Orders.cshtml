@page
@model INF4027W_BPTTIN002_MiniPrj_2026.Pages.Account.OrdersModel
@{
    ViewData["Title"] = "My Orders";
}

<div role="main" class="main shop py-4">
    <div class="container">

        @* Breadcrumb *@
        <ul class="breadcrumb breadcrumb-style-2 mb-4">
            <li class="breadcrumb-item">
                <a asp-page="/Index">Home</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-page="/Account/Index">My Account</a>
            </li>
            <li class="breadcrumb-item active">Orders</li>
        </ul>

        <div class="row">

            @* Sidebar *@
            <div class="col-lg-3 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <div class="rounded-circle bg-dark d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width:64px;height:64px;">
                                <i class="fas fa-user text-white" style="font-size:24px;"></i>
                            </div>
                            <p class="font-weight-bold text-color-dark mb-0">@Model.CustomerName</p>
                            <small class="text-muted">Customer</small>
                        </div>
                        <nav class="d-flex flex-column gap-1">
                            <a asp-page="/Account/Index"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none text-muted"
                               style="transition:background 0.2s;">
                                <i class="fas fa-th-large" style="width:16px;"></i> Dashboard
                            </a>
                            <a asp-page="/Account/Orders"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none font-weight-semibold text-color-dark"
                               style="background:#f5f5f5;">
                                <i class="fas fa-box" style="width:16px;"></i> Orders
                            </a>
                            <a asp-page="/Account/Profile"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none text-muted"
                               style="transition:background 0.2s;">
                                <i class="fas fa-user-edit" style="width:16px;"></i> Account Details
                            </a>
                            <a asp-page="/Account/Wishlist"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none text-muted"
                               style="transition:background 0.2s;">
                                <i class="fas fa-heart" style="width:16px;"></i> Wishlist
                            </a>
                            <hr class="my-2">
                            <a asp-page="/Account/Logout"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none text-danger"
                               style="transition:background 0.2s;">
                                <i class="fas fa-sign-out-alt" style="width:16px;"></i> Logout
                            </a>
                        </nav>
                    </div>
                </div>
            </div>

            @* Main content *@
            <div class="col-lg-9">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between">
                        <h5 class="font-weight-bold text-color-dark mb-0">
                            <i class="fas fa-box me-2 text-primary"></i>My Orders
                        </h5>
                        <span class="badge bg-dark text-white px-3 py-2">
                            @Model.Orders.Count order@(Model.Orders.Count != 1 ? "s" : "")
                        </span>
                    </div>
                    <div class="card-body p-0">

                        @if (!Model.Orders.Any())
                        {
                            @* Empty state *@
                            <div class="text-center py-5 my-3">
                                <i class="fas fa-box-open text-muted mb-4" style="font-size:56px;opacity:0.2;"></i>
                                <h5 class="font-weight-bold text-color-dark mb-2">No orders yet</h5>
                                <p class="text-muted mb-4">When you place an order, it will appear here.</p>
                                <a asp-page="/Products/Index" class="btn btn-dark btn-px-5 btn-py-3">
                                    Start Shopping
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table mb-0" style="min-width:600px;">
                                    <thead style="background:#f8f9fa;">
                                        <tr>
                                            <th class="px-4 py-3 text-uppercase text-2 font-weight-bold text-color-dark border-0">Order</th>
                                            <th class="px-4 py-3 text-uppercase text-2 font-weight-bold text-color-dark border-0">Date</th>
                                            <th class="px-4 py-3 text-uppercase text-2 font-weight-bold text-color-dark border-0">Items</th>
                                            <th class="px-4 py-3 text-uppercase text-2 font-weight-bold text-color-dark border-0">Total</th>
                                            <th class="px-4 py-3 text-uppercase text-2 font-weight-bold text-color-dark border-0">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in Model.Orders)
                                        {
                                            <tr style="border-top:1px solid #f0f0f0;">
                                                <td class="px-4 py-3 align-middle">
                                                    <span class="font-weight-semibold text-color-dark">#@order.Id.Replace("order_", "")</span>
                                                </td>
                                                <td class="px-4 py-3 align-middle text-muted">
                                                    @order.OrderDate.ToDateTime().ToString("dd MMM yyyy")
                                                </td>
                                                <td class="px-4 py-3 align-middle">
                                                    <div class="d-flex flex-column gap-1">
                                                        @foreach (var item in order.Items.Take(2))
                                                        {
                                                            <span class="text-2 text-muted">@item.ProductName × @item.Quantity</span>
                                                        }
                                                        @if (order.Items.Count > 2)
                                                        {
                                                            <span class="text-2 text-muted">+@(order.Items.Count - 2) more</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3 align-middle">
                                                    <span class="font-weight-bold text-color-dark">R @order.TotalAmount.ToString("N0")</span>
                                                </td>
                                                <td class="px-4 py-3 align-middle">
                                                    @if (order.Status == INF4027W_BPTTIN002_MiniPrj_2026.Models.OrderStatus.Paid)
                                                    {
                                                        <span class="badge px-3 py-2"
                                                              style="background:#e8f5e9;color:#2e7d32;font-size:11px;font-weight:600;border-radius:20px;">
                                                            <i class="fas fa-check-circle me-1"></i>Paid
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge px-3 py-2"
                                                              style="background:#fce4ec;color:#c62828;font-size:11px;font-weight:600;border-radius:20px;">
                                                            <i class="fas fa-times-circle me-1"></i>Cancelled
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>
                </div>

                @* Continue shopping *@
                <div class="mt-3 text-end">
                    <a asp-page="/Products/Index"
                       class="btn btn-outline btn-outline-2 font-weight-semibold"
                       style="border-color:#ccc;color:#333;padding:10px 24px;">
                        ← Continue Shopping
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
