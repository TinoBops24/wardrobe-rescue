@page
@model INF4027W_BPTTIN002_MiniPrj_2026.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Account Details";
}

<div role="main" class="main shop py-4">
    <div class="container">

        @* Breadcrumb *@
        <ul class="breadcrumb breadcrumb-style-2 mb-4">
            <li class="breadcrumb-item">
                <a asp-page="/Index">Home</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-page="/Account/Index">My Account</a>
            </li>
            <li class="breadcrumb-item active">Account Details</li>
        </ul>

        <div class="row">

            @* Sidebar *@
            <div class="col-lg-3 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <div class="rounded-circle bg-dark d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width:64px;height:64px;">
                                <i class="fas fa-user text-white" style="font-size:24px;"></i>
                            </div>
                            <p class="font-weight-bold text-color-dark mb-0">@Model.CustomerName</p>
                            <small class="text-muted">Customer</small>
                        </div>
                        <nav class="d-flex flex-column gap-1">
                            <a asp-page="/Account/Index"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none text-muted"
                               style="transition:background 0.2s;">
                                <i class="fas fa-th-large" style="width:16px;"></i> Dashboard
                            </a>
                            <a asp-page="/Account/Orders"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none text-muted"
                               style="transition:background 0.2s;">
                                <i class="fas fa-box" style="width:16px;"></i> Orders
                            </a>
                            <a asp-page="/Account/Profile"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none font-weight-semibold text-color-dark"
                               style="background:#f5f5f5;">
                                <i class="fas fa-user-edit" style="width:16px;"></i> Account Details
                            </a>
                            <a asp-page="/Account/Wishlist"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none text-muted"
                               style="transition:background 0.2s;">
                                <i class="fas fa-heart" style="width:16px;"></i> Wishlist
                            </a>
                            <hr class="my-2">
                            <a asp-page="/Account/Logout"
                               class="d-flex align-items-center gap-2 px-3 py-2 rounded text-decoration-none text-danger"
                               style="transition:background 0.2s;">
                                <i class="fas fa-sign-out-alt" style="width:16px;"></i> Logout
                            </a>
                        </nav>
                    </div>
                </div>
            </div>

            @* Main content *@
            <div class="col-lg-9">

                @* Alerts *@
                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["ProfileSuccess"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ProfileError"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ProfileError"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom px-4 py-3">
                        <h5 class="font-weight-bold text-color-dark mb-0">
                            <i class="fas fa-user-edit me-2 text-primary"></i>Account Details
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <form method="post">
                            @Html.AntiForgeryToken()

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.FirstName" class="form-label font-weight-semibold text-color-dark text-2 text-uppercase">
                                        First Name <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Input.FirstName"
                                           class="form-control"
                                           style="border-radius:4px;border:1px solid #ddd;padding:10px 14px;" />
                                    <span asp-validation-for="Input.FirstName" class="text-danger text-2"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.LastName" class="form-label font-weight-semibold text-color-dark text-2 text-uppercase">
                                        Last Name <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Input.LastName"
                                           class="form-control"
                                           style="border-radius:4px;border:1px solid #ddd;padding:10px 14px;" />
                                    <span asp-validation-for="Input.LastName" class="text-danger text-2"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Input.Email" class="form-label font-weight-semibold text-color-dark text-2 text-uppercase">
                                    Email Address <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Email"
                                       class="form-control"
                                       readonly
                                       style="border-radius:4px;border:1px solid #ddd;padding:10px 14px;background:#f8f9fa;color:#888;" />
                                <small class="text-muted">Email address cannot be changed.</small>
                            </div>

                            <div class="border-top pt-4">
                                <button type="submit" class="btn btn-dark btn-px-5 btn-py-3 font-weight-semibold text-uppercase">
                                    Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
